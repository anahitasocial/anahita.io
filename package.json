{
  "name": "anahita.io",
  "version": "0.1.0",
  "private": true,
  "description": "The website of Anahita, at https://www.anahita.io",
  "license": "MIT",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 4000",
